{
  "manifest_version": 3,
  "name": "Oscar — Tab Auto-Closer",
  "short_name": "Oscar",
  "version": "0.1.15",
  "description": "Auto-closes tabs after desktop-app deep links fire (Slack, Zoom, Teams, etc). Matches on domain + page text.",
  "author": "Jonny Linford",
  "homepage_url": "https://github.com/jonathanlinford/oscar",
  "permissions": ["storage", "tabs", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["matching.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oscar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
